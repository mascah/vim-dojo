function! vim_dojo#skills#registers#Techniques() abort
  return [
        \ {'id': 'named-register', 'keys': '"a "b …', 'name': 'Named registers',
        \  'card': ['"a before a yank or delete stores the text in register a; "ap puts it back, however many deletes happen in between.',
        \           'Use one when you need to keep a piece of text safe while you delete other things.'],
        \  'detect': {'n': '\C"[a-zA-Z][yd].*"[a-z][pP]'},
        \  'drills': [
        \ {'id': 'keep-constant', 'ft': 'python',
        \  'vars': {'const': [{'name': 'LICENSE', 'value': '"MIT"'}, {'name': 'AUTHOR', 'value': '"Sam Lee"'},
        \                     {'name': 'VERSION', 'value': '"2.1"'}],
        \           'junk': ['DEBUG_ONLY = True', 'TRACE = 1', 'SKIP_AUTH = True']},
        \  'goal': 'Delete the line {junk}, then copy the {name} line to the end of the file.',
        \  'lines': ['{name} = {value}',
        \            '{junk}',
        \            'def main():',
        \            '    pass'],
        \  'solution': '"ayyjddG"ap',
        \  'hint': 'Yank the first line into a letter register before the delete overwrites the default one.',
        \  'why': 'A named register keeps its text no matter how many deletes come after.'},
        \ ]},
        \ {'id': 'yank-register', 'keys': '"0', 'name': 'The yank register',
        \  'card': ['"0 always holds your last yank; deletes go elsewhere, so "0p still puts what you yanked.',
        \           'Reach for it when p pastes the text you just deleted instead of the text you copied.'],
        \  'detect': {'n': '\C"0[pP]'},
        \  'drills': [
        \ {'id': 'copy-region', 'ft': 'python',
        \  'vars': {'region': ['eu-west-1', 'us-east-2', 'ap-south-1'],
        \           'names': [{'a': 'primary', 'b': 'backup', 'c': 'fallback'},
        \                     {'a': 'main', 'b': 'replica', 'c': 'standby'}]},
        \  'goal': 'Replace both TBD values with "{region}".',
        \  'lines': ['{a} = "{region}"',
        \            '{b} = "TBD"',
        \            '{c} = "TBD"'],
        \  'solution': 'yi"jdi""0Pjdi""0P',
        \  'hint': 'Deleting TBD replaces what p would put. Your yank is still in register 0.',
        \  'why': '"0 keeps the yank even after a delete has taken over the default register.'},
        \ ]},
        \ {'id': 'insert-register', 'keys': 'Ctrl-R in Insert', 'name': 'Insert a register while typing',
        \  'card': ['In Insert mode, Ctrl-R followed by a register name types that register''s text, such as Ctrl-R 0 for the last yank.',
        \           'Use it to drop a long name into new text without leaving Insert mode.'],
        \  'detect': {'i': '\C<C-R>'},
        \  'drills': [
        \ {'id': 'log-function', 'ft': 'python',
        \  'vars': {'name': ['load_inventory', 'refresh_tokens', 'export_report', 'rebuild_search_index']},
        \  'goal': 'Below pass, add the line log("{name}").',
        \  'lines': ['def {name}():',
        \            '    pass'],
        \  'solution': 'wyiwjolog("<C-R>0")<Esc>',
        \  'hint': 'Yank the function name first, then insert it from a register while typing the new line.',
        \  'why': 'Ctrl-R 0 types the yanked name for you, spelled exactly right.'},
        \ ]},
        \ {'id': 'macro', 'keys': 'q @', 'name': 'Record and play a macro',
        \  'card': ['qa starts recording your keys into register a and q stops; @a plays them back, and 3@a plays them three times.',
        \           'Record one line''s worth of edits when the same change is needed on many lines.'],
        \  'detect': {'n': '\Cq[a-z].*q.*@[a-z]'},
        \  'drills': [
        \ {'id': 'quote-list', 'ft': 'python',
        \  'vars': {'words': [{'a': 'apple', 'b': 'banana', 'c': 'cherry', 'd': 'damson'},
        \                     {'a': 'red', 'b': 'green', 'c': 'blue', 'd': 'violet'},
        \                     {'a': 'north', 'b': 'south', 'c': 'east', 'd': 'west'}]},
        \  'goal': 'Turn every line into a quoted string followed by a comma, like "{a}",',
        \  'lines': ['{a}', '{b}', '{c}', '{d}'],
        \  'solution': 'qaI"<Esc>A",<Esc>jq3@a',
        \  'hint': 'Record the edit for the first line, ending on the next line, then play it for the rest.',
        \  'why': 'A macro that ends by moving to the next line can be played with a count.'},
        \ ]},
        \ {'id': 'macro-again', 'keys': '@@', 'name': 'Play the last macro again',
        \  'card': ['@@ plays whichever macro you played last, so after @a you keep going with @@.',
        \           'Use it to step through lines one at a time, checking each before you repeat.'],
        \  'detect': {'n': '\C@@'},
        \  'drills': [
        \ {'id': 'await-calls', 'ft': 'python',
        \  'vars': {'calls': [{'a': 'fetch_users()', 'b': 'fetch_orders()', 'c': 'fetch_items()'},
        \                     {'a': 'load_config()', 'b': 'open_cache()', 'c': 'warm_index()'},
        \                     {'a': 'send_email()', 'b': 'send_sms()', 'c': 'send_push()'}],
        \           'word': ['await ', 'yield ']},
        \  'goal': 'Put {word}before each of the three calls.',
        \  'lines': ['{a}', '{b}', '{c}'],
        \  'solution': 'qaI{word}<Esc>jq@a@@',
        \  'hint': 'Record the change on the first line, play it once, then repeat the last macro.',
        \  'why': '@@ repeats the last macro without naming its register again.'},
        \ ]},
        \ ]
endfunction
