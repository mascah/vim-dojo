function! vim_dojo#skills#visual#Techniques() abort
  return [
        \ {'id': 'charwise', 'keys': 'v', 'name': 'Select characters',
        \  'card': ['v starts selecting at the cursor; any motion grows the selection, then an operator such as c or d acts on it.',
        \           'Use it when the text to change is not a neat word or object and you want to see it before you act.'],
        \  'drills': [
        \ {'id': 'retitle', 'ft': 'python', 'start': '{a1}',
        \  'vars': {'adj': [{'a1': 'quick', 'a2': 'easy'}, {'a1': 'complete', 'a2': 'illustrated'}, {'a1': 'short', 'a2': 'friendly'}],
        \           'new': ['practical', 'definitive', 'modern'], 'topic': ['Vim', 'regular expressions', 'shell scripts']},
        \  'goal': 'Change "{a1} {a2}" in the title to "{new}".',
        \  'lines': ['TITLE = "The {a1} {a2} guide to {topic}"'],
        \  'solution': 'veec{new}<Esc>'},
        \ ]},
        \ {'id': 'linewise', 'keys': 'V', 'name': 'Select whole lines',
        \  'card': ['V selects whole lines; move up or down to add lines, then an operator such as >, d or y acts on all of them.',
        \           'Reach for it to indent, delete or copy a block of lines you can see.'],
        \  'drills': [
        \ {'id': 'indent-body', 'ft': 'python', 'start': 'count',
        \  'vars': {'attr': ['active', 'paid', 'shipped'], 'list': ['items', 'orders']},
        \  'goal': 'Indent the two lines after the if, so they belong to it.',
        \  'lines': ['for item in {list}:',
        \            '    if item.{attr}:',
        \            '    count += 1',
        \            '    total += item.price',
        \            '    log(item)',
        \            'print(total)'],
        \  'solution': 'Vj>'},
        \ ]},
        \ {'id': 'block', 'keys': 'Ctrl-V I A', 'name': 'Block insert and append',
        \  'card': ['Ctrl-V selects a rectangle; I inserts text before it and A after it, on every line at once.',
        \           'Use it to comment out lines or add the same text to the end of several lines.'],
        \  'drills': [
        \ {'id': 'comment-block', 'ft': 'python', 'start': '{a} =',
        \  'vars': {'names': [{'a': 'host', 'b': 'port', 'c': 'user'}, {'a': 'region', 'b': 'bucket', 'c': 'key'},
        \           {'a': 'token', 'b': 'org', 'c': 'repo'}], 'prefix': ['APP', 'SVC']},
        \  'goal': 'Comment out the three environment lines by putting "# " in front of each.',
        \  'lines': ['import os',
        \            '{a} = os.environ["{prefix}_{a}"]',
        \            '{b} = os.environ["{prefix}_{b}"]',
        \            '{c} = os.environ["{prefix}_{c}"]',
        \            'connect()'],
        \  'solution': '<C-V>jjI# <Esc>'},
        \ {'id': 'append-commas', 'ft': 'python', 'start': '"{c1}"',
        \  'vars': {'colors': [{'c1': 'red', 'c2': 'green', 'c3': 'blue'}, {'c1': 'teal', 'c2': 'amber', 'c3': 'violet'},
        \           {'c1': 'black', 'c2': 'white', 'c3': 'grey'}], 'name': ['colors', 'palette']},
        \  'goal': 'Add a comma to the end of each of the three strings.',
        \  'lines': ['{name} = [',
        \            '    "{c1}"',
        \            '    "{c2}"',
        \            '    "{c3}"',
        \            ']'],
        \  'solution': '<C-V>jj$A,<Esc>'},
        \ ]},
        \ {'id': 'reselect', 'keys': 'gv', 'name': 'Reselect the last selection',
        \  'card': ['gv selects again exactly what you selected last time.',
        \           'Use it when one command ended the selection and you want a second command on the same text.'],
        \  'drills': [
        \ {'id': 'sort-imports', 'ft': 'go', 'start': '"{c}"',
        \  'vars': {'pkgs': [{'a': 'fmt', 'b': 'os', 'c': 'strings'}, {'a': 'bufio', 'b': 'io', 'c': 'sort'},
        \           {'a': 'errors', 'b': 'net', 'c': 'time'}]},
        \  'goal': 'Sort the three imports, then indent them one level.',
        \  'lines': ['import (',
        \            '"{c}"',
        \            '"{a}"',
        \            '"{b}"',
        \            ')'],
        \  'solution': 'Vjj:sort<CR>gv>'},
        \ ]},
        \ ]
endfunction
