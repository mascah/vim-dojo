function! vim_dojo#skills#edit#Techniques() abort
  return [
        \ {'id': 'operator', 'keys': 'd c y + motion', 'name': 'Operator and motion',
        \  'card': ['An operator (d delete, c change, y yank) takes a motion: dw deletes to the next word, c$ changes to the end of the line.',
        \           'Think "verb then where" instead of deleting one character at a time.'],
        \  'detect': {'n': '\C[dcy]\d*\%([wbeWBEhjkl$0^{}G%]\|[ftFT].\)\|[CD]'},
        \  'drills': [
        \ {'id': 'delete-word', 'ft': 'text',
        \  'vars': {'word': ['draft', 'old', 'unused', 'temporary'], 'rest': ['release notes', 'config values', 'build steps']},
        \  'lines': ['{word} {rest}'],
        \  'goal': 'Remove the word {word} and its following space.',
        \  'solution': 'dw',
        \  'hint': 'Combine delete with a word motion.',
        \  'why': 'w takes the operator to the start of the next word.'},
        \ {'id': 'change-to-end', 'ft': 'python', 'start': '#',
        \  'vars': {'code': ['retries = 3', 'timeout = 30', 'debug = False'],
        \           'old': ['# FIXME', '# old value', '# temporary'], 'new': ['# from config', '# tuned in prod']},
        \  'lines': ['{code}  {old}'],
        \  'goal': 'Replace the comment with "{new}".',
        \  'solution': 'C{new}<Esc>',
        \  'hint': 'Change from the cursor to the end of the line.',
        \  'why': 'C is c$: it changes everything after the cursor and leaves the code alone.'},
        \ ]},
        \ {'id': 'line-ops', 'keys': 'dd cc yy', 'name': 'Whole-line operations',
        \  'card': ['Doubling an operator acts on the whole line: dd deletes it, cc replaces it, yy copies it.',
        \           'Reach for them when the line is the unit, wherever the cursor sits on it.'],
        \  'detect': {'n': '\Cdd\|cc\|yy'},
        \  'drills': [
        \ {'id': 'remove-debug-line', 'ft': 'python', 'start': '{debug}',
        \  'vars': {'fn': ['load_items', 'parse_rows', 'save_batch'],
        \           'debug': ['print(items)', 'breakpoint()', 'import pdb; pdb.set_trace()']},
        \  'lines': ['def {fn}(items):', '    {debug}', '    return sorted(items)'],
        \  'goal': 'Delete the debugging line from {fn}().',
        \  'solution': 'dd',
        \  'hint': 'Double the delete operator.',
        \  'why': 'dd removes the line wherever the cursor is on it.'},
        \ {'id': 'rewrite-comment', 'ft': 'python', 'start': 'TODO',
        \  'vars': {'old': ['fix this later', 'clean up', 'remove this hack'],
        \           'new': ['Cached for speed.', 'Kept for old clients.', 'Safe to call twice.']},
        \  'lines': ['# TODO: {old}', 'value = compute()'],
        \  'goal': 'Replace the whole first line with "# {new}".',
        \  'solution': 'cc# {new}<Esc>',
        \  'hint': 'Double the change operator.',
        \  'why': 'cc clears the line and leaves you in Insert mode to type the new one.'},
        \ {'id': 'duplicate-row', 'ft': 'python', 'start': '{port}',
        \  'vars': {'port': ['8080', '8443', '9000'], 'name': ['ports', 'allowed', 'listen_on']},
        \  'lines': ['{name} = [', '    {port},', ']'],
        \  'goal': 'Duplicate the {port} line so it appears twice.',
        \  'solution': 'yyp',
        \  'hint': 'Copy the line, then put it below.',
        \  'why': 'yy copies the whole line, so p puts it on a line of its own.'},
        \ ]},
        \ {'id': 'x-r', 'keys': 'x r', 'name': 'Delete or replace one character',
        \  'card': ['x deletes the character under the cursor; r{char} replaces it without leaving Normal mode.',
        \           'Use them for one-letter typos and single symbols, not for whole words.'],
        \  'detect': {'n': '\C[xr]'},
        \  'drills': [
        \ {'id': 'extra-letter', 'ft': 'python', 'start': '{at}',
        \  'vars': {'typo': [{'bad': 'priint', 'good': 'print', 'at': 'ii'},
        \                    {'bad': 'loggger', 'good': 'logger', 'at': 'ggg'},
        \                    {'bad': 'appennd', 'good': 'append', 'at': 'nn'}]},
        \  'lines': ['for item in items:', '    {bad}(item)'],
        \  'goal': 'Remove the extra letter so the call reads {good}(item).',
        \  'solution': 'x',
        \  'hint': 'One key deletes the character under the cursor.',
        \  'why': 'x is the smallest edit there is: one key, one character.'},
        \ {'id': 'fix-operator', 'ft': 'python', 'start': '!',
        \  'vars': {'name': ['retries', 'count', 'attempts'], 'limit': ['0', '3', '10'],
        \           'action': ['stop', 'retry', 'log_error']},
        \  'lines': ['if {name} != {limit}:', '    {action}()'],
        \  'goal': 'Make the condition test for equality (==).',
        \  'solution': 'r=',
        \  'hint': 'Replace the character under the cursor.',
        \  'why': 'r swaps one character and you stay in Normal mode.'},
        \ ]},
        \ {'id': 'insert-at', 'keys': 'A I o O', 'name': 'Insert at the right place',
        \  'card': ['A appends at the end of the line and I inserts before its first character; o and O open a new line below or above.',
        \           'They move and enter Insert mode in one key, from anywhere on the line.'],
        \  'detect': {'n': '\C[AIoO]'},
        \  'drills': [
        \ {'id': 'append-unit', 'ft': 'text',
        \  'vars': {'name': ['timeout', 'interval', 'delay'], 'value': ['30', '45', '90'], 'unit': ['s', 'ms']},
        \  'lines': ['{name} = {value}'],
        \  'goal': 'Append the unit {unit} to the {name}.',
        \  'solution': 'A{unit}<Esc>',
        \  'hint': 'Enter Insert mode at the end of the line.',
        \  'why': 'A appends from anywhere on the line.'},
        \ {'id': 'comment-out', 'ft': 'python', 'start': '{arg}',
        \  'vars': {'call': ['send_email', 'flush_cache', 'notify_admin'], 'arg': ['user', 'force=True', 'event']},
        \  'lines': ['{call}({arg})'],
        \  'goal': 'Comment out the line by putting "# " in front of it.',
        \  'solution': 'I# <Esc>',
        \  'hint': 'Insert before the first character, wherever the cursor is.',
        \  'why': 'I jumps to the start of the text and enters Insert mode in one key.'},
        \ {'id': 'add-line-below', 'ft': 'text',
        \  'vars': {'first': ['milk', 'eggs', 'bread'], 'second': ['rice', 'beans', 'tea'], 'new': ['salt', 'oats', 'honey']},
        \  'lines': ['- {first}', '- {second}'],
        \  'goal': 'Add "- {new}" on a new line between the two items.',
        \  'solution': 'o- {new}<Esc>',
        \  'hint': 'Open a new line below the cursor.',
        \  'why': 'o opens a line below and enters Insert mode, wherever the cursor is.'},
        \ ]},
        \ {'id': 'join', 'keys': 'J', 'name': 'Join lines',
        \  'card': ['J joins the next line onto this one and puts a single space between them.',
        \           'Use it to undo an unwanted line break without deleting characters by hand.'],
        \  'detect': {'n': '\CJ'},
        \  'drills': [
        \ {'id': 'join-title', 'ft': 'text',
        \  'vars': {'first': ['Practice', 'Release', 'Meeting'], 'second': ['log', 'notes', 'summary']},
        \  'lines': ['{first}', '{second}'],
        \  'goal': 'Join the two lines with one space.',
        \  'solution': 'J',
        \  'hint': 'Use the Normal mode join command.',
        \  'why': 'J joins the following line and handles the space.'},
        \ ]},
        \ {'id': 'put', 'keys': 'p P', 'name': 'Put what you deleted or yanked',
        \  'card': ['p puts the last deleted or yanked text after the cursor, P before it; whole lines go below or above.',
        \           'Delete then put is how Vim moves text: dd then p swaps two lines.'],
        \  'detect': {'n': '\C[pP]'},
        \  'drills': [
        \ {'id': 'swap-steps', 'ft': 'text',
        \  'vars': {'steps': [{'first': 'make build', 'second': 'make test', 'third': 'make deploy'},
        \                     {'first': 'git add .', 'second': 'git commit', 'third': 'git push'},
        \                     {'first': 'npm install', 'second': 'npm test', 'third': 'npm publish'}]},
        \  'lines': ['{second}', '{first}', '{third}'],
        \  'goal': 'Put the first two lines in order: "{first}" before "{second}".',
        \  'solution': 'ddp',
        \  'hint': 'Delete the line, then put it back below the next one.',
        \  'why': 'Deleted text waits in a register, so dd then p moves the line down.'},
        \ {'id': 'swap-letters', 'ft': 'text', 'start': '{at}',
        \  'vars': {'typo': [{'line': 'Open teh settings first.', 'at': 'eh', 'good': 'the'},
        \                    {'line': 'Save adn close the file.', 'at': 'dn', 'good': 'and'},
        \                    {'line': 'Wait fro the build.', 'at': 'ro', 'good': 'for'}]},
        \  'lines': ['{line}'],
        \  'goal': 'Fix the swapped letters so the word reads "{good}".',
        \  'solution': 'xp',
        \  'hint': 'Delete the letter under the cursor, then put it after the next one.',
        \  'why': 'x leaves the letter in a register and p puts it one place further on.'},
        \ ]},
        \ {'id': 'undo', 'keys': 'u Ctrl-R', 'name': 'Undo and redo',
        \  'card': ['u undoes the last change and Ctrl-R redoes it; each press steps one change further.',
        \           'Undo a mistake instead of retyping, and redo when you undid one step too many.'],
        \  'detect': {'n': '\Cu\|<C-R>'},
        \  'drills': [
        \ {'id': 'undo-delete', 'ft': 'python', 'start': 'return',
        \  'vars': {'fn': ['total', 'average', 'score'], 'check': ['if not items:', 'if items is None:']},
        \  'history': [['def {fn}(items):', '    {check}', '        return 0', '    return sum(items)']],
        \  'lines': ['def {fn}(items):', '        return 0', '    return sum(items)'],
        \  'goal': 'The line "{check}" was just deleted by mistake. Bring it back.',
        \  'solution': 'u',
        \  'hint': 'Vim remembers the change you just made.',
        \  'why': 'u restores exactly what the last change removed.'},
        \ {'id': 'undo-twice', 'ft': 'text',
        \  'vars': {'a': ['alpha', 'north', 'red'], 'b': ['beta', 'south', 'green'], 'c': ['gamma', 'east', 'blue']},
        \  'history': [['{a} {b} {c}'], ['{a} {c}']],
        \  'lines': ['{c}'],
        \  'goal': 'Undo the last two changes so the line reads "{a} {b} {c}" again.',
        \  'solution': 'uu',
        \  'hint': 'Each undo steps back one change.',
        \  'why': 'Pressing u again keeps walking back through your changes.'},
        \ {'id': 'redo-rename', 'ft': 'python',
        \  'vars': {'old': ['tmp', 'val', 'x'], 'new': ['subtotal', 'price', 'count']},
        \  'lines': ['{old} = load()'],
        \  'redo': [['{new} = load()']],
        \  'goal': 'The rename to {new} was undone by mistake. Bring it back.',
        \  'solution': '<C-R>',
        \  'hint': 'The opposite of undo.',
        \  'why': 'Ctrl-R redoes what u undid, so nothing is lost by undoing too far.'},
        \ ]},
        \ ]
endfunction
